generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  /// DIRECTOR | OPERATOR
  role         String   @default("OPERATOR")
  active       Boolean  @default(true)
  /// Global Sync site login (plain; not Bracho login)
  globalSyncLogin String @default("")
  /// Encrypted Global Sync password
  globalSyncPasswordEnc String @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ankety Anketa[] @relation("OperatorAnkety")

  createdById String?
  createdBy   User?   @relation("CreatedOperators", fields: [createdById], references: [id])
  operators   User[]  @relation("CreatedOperators")

  presence AnketaPresence[]
}

model Anketa {
  id          String   @id @default(cuid())
  /// Golden Bride login (profile ID)
  externalId  String
  /// Shown name in admin (e.g. Valentina)
  displayName String
  /// Encrypted Golden Bride password for this anketa
  passwordEnc String  @default("")
  /// Cached main photo URL from Golden (CloudFront)
  avatarUrl   String?
  site        String   @default("goldenbride")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Null = unassigned pool (Account Manager left column)
  operatorId String?
  operator   User?   @relation("OperatorAnkety", fields: [operatorId], references: [id], onDelete: SetNull)

  presence AnketaPresence?

  @@unique([site, externalId])
  @@index([operatorId])
}

/// Live "online" when an operator has this questionnaire open in Bracho.
model AnketaPresence {
  anketaId     String   @id
  anketa       Anketa   @relation(fields: [anketaId], references: [id], onDelete: Cascade)
  operatorId   String
  operator     User     @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  externalId   String
  displayName  String
  lastSeenAt   DateTime @default(now())

  @@index([lastSeenAt])
  @@index([operatorId])
}

/// Men's Golden IDs for Goldman Agency list (director-managed).
model GoldmanManId {
  id         String   @id @default(cuid())
  /// Men's profile ID on Golden Bride
  externalId String   @unique
  /// Auto-collected from Home viewer toasts (payee / replenished). Orange in UI until acknowledged.
  isNew      Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isNew, createdAt])
}
